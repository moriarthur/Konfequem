# ==== Backend ====
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True

# Database Configuration
# For Docker: uncomment this
#DATABASE_URL=postgresql://admin:secret@db:5432/booking
#DOCKER=true

# For local development: uncomment this
#DATABASE_URL=postgresql://admin:secret@localhost:5432/konfequem
#DOCKER=false

# Frontend Configuration
VITE_BACKEND_URL=http://localhost:8000

# Security Settings
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Timezone and Locale
TZ=Europe/Berlin
LANGUAGE_CODE=en-us

# Office Hours
OFFICE_START=8
OFFICE_END=22