# Local Environment Configuration
# For macOS/Windows without Docker (local development)
#
# Usage:
#   cp .env.local.example .env
#   cd backend && python manage.py migrate && python manage.py runserver
#   cd frontend && npm run dev

# ==== Django ====
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DOCKER=false

# ==== Database - PostgreSQL (required; settings.py is Postgres-only) ====
# Point at the docker `db` service (docker compose up -d db, exposed on
# 127.0.0.1:5433) or any local Postgres install.
DATABASE_URL=postgresql://admin:change-me-local-only@127.0.0.1:5433/konfequem

# ==== Frontend ====
VITE_BACKEND_URL=http://localhost:8000
