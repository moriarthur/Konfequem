# IMPORTANT: Choose ONE environment and copy that file:

# For Windows/WSL with Docker:
#   cp .env.docker.example .env
#   docker compose up -d
#   docker compose exec backend python manage.py migrate

# For macOS/Windows without Docker:
#   cp .env.local.example .env
#   cd backend && python manage.py migrate && python manage.py runserver
#   cd frontend && npm run dev

# See .env.docker.example and .env.local.example for detailed configuration options.

